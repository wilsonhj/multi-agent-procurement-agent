# Copy to .env and fill in. Never commit .env.
#
# NFR-03: contract and pricing documents are confidential. The confidential path
# must use self-hosted or enterprise endpoints with no third-party training on
# contract data. Point these at an enterprise deployment before ingesting any
# contract.

# --- LLM / embeddings (swappable per NFR-04) ---
PROCUREMENT_LLM_ENDPOINT=
PROCUREMENT_LLM_MODEL=
PROCUREMENT_LLM_API_KEY=
PROCUREMENT_EMBEDDING_ENDPOINT=
PROCUREMENT_EMBEDDING_MODEL=

# --- Stores ---
# Relational store holds canonical records + immutable audit log (NFR-02).
PROCUREMENT_DATABASE_URL=
PROCUREMENT_VECTOR_STORE_URL=
PROCUREMENT_OBJECT_STORE_URL=

# --- Web search (supplement-only, FR-WEB-01..05) ---
PROCUREMENT_WEB_SEARCH_API_KEY=

# --- Review routing (clarifications.md D-3) ---
# There is deliberately no HITL confidence threshold and no global numeric
# conflict tolerance. Both were removed: tau is read per field tier off a
# risk-coverage fit, and tolerance is per-field with three kinds. Setting the
# old PROCUREMENT_HITL_CONFIDENCE_THRESHOLD or PROCUREMENT_NUMERIC_CONFLICT_
# TOLERANCE here now does nothing at all - Settings ignores unknown keys.
PROCUREMENT_TARGET_PRECISION_AUTO_ACCEPTED=0.99
PROCUREMENT_REVIEW_BUDGET_FRACTION=0.20

# --- Compose gate (issue #14). 0 informational .. 4 critical; higher is worse.
# Unresolved conflicts ABOVE this level refuse composition.
PROCUREMENT_COMPOSE_GATE_THRESHOLD=2

# --- Concurrency. Size the parse pool off MEAN page cost, not median. ---
PROCUREMENT_MAX_CONCURRENT_PARSE=4
PROCUREMENT_MAX_CONCURRENT_LLM=8
PROCUREMENT_WEB_SEARCH_RATE_LIMIT_PER_MINUTE=30
